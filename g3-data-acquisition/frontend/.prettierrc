{
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-svelte"],
    "overrides": [
        { "files": "*.svelte", "options": { "parser": "svelte" } },
        { "files": ["*.md", "*.yml", "*.yaml"], "options": { "useTabs": false, "tabWidth": 2 } }
    ]
}
